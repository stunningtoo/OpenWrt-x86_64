# Drop each package build tree once it is installed (include/package.mk:292).
# A 272-package x86_64 build with the Go proxy stack does not fit in the 72G
# runner disk otherwise; dl/ and the kernel tree are kept.
CONFIG_AUTOREMOVE=y
CONFIG_TARGET_KERNEL_PARTSIZE=2048
CONFIG_TARGET_ROOTFS_PARTSIZE=4096
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TESTING_KERNEL=y
CONFIG_ZSTD_OPTIMIZE_O3=y
CONFIG_boost-compile-visibility-hidden=y
CONFIG_boost-runtime-shared=y
CONFIG_boost-static-and-shared-libs=y
CONFIG_boost-variant-release=y
# Keep the rust toolchain out of the build: it costs about three hours of compile
# time on a 2 vCPU runner and the job is capped at six hours. shadowsocks-libev-ss-local
# and ss-redir stay enabled, so SS keeps working without it.
# CONFIG_PACKAGE_rust is not set
# CONFIG_PACKAGE_shadowsocks-rust-sslocal is not set
# CONFIG_PACKAGE_shadowsocks-rust-ssserver is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall_INCLUDE_Shadowsocks_Rust_Server is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Client is not set
# CONFIG_PACKAGE_luci-app-passwall2_INCLUDE_Shadowsocks_Rust_Server is not set
# Dropped for the six hour budget (run 40503701918 needed roughly 6h30m):
# the whole docker stack (dockerd/containerd/runc/compose plus three LuCI
# front ends). One revert away if it is wanted back - the job then needs a
# longer ceiling.
# The out-of-tree Realtek r8168 driver does not build against this kernel any
# more, and the in-tree r8169 driver covers the same chips, so it is pinned off
# instead of dragging a broken package through every run.
# sing-box failed to build in that same run (nothing else did) and the parallel
# pass never named a reason, so it is out until it gets its own investigation.
# Passwall keeps xray, hysteria, tuic, trojan, naive and the ss/ssr stack.
# ruby is NOT pinnable: luci-app-openclash/Makefile:46 is +ruby +ruby-yaml, so
# defconfig switches the runtime back on to satisfy that dependency.
# CONFIG_PACKAGE_containerd is not set
# CONFIG_PACKAGE_docker is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_dockerd is not set
# CONFIG_PACKAGE_luci-app-docker is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-lib-docker is not set
# CONFIG_PACKAGE_luci-i18n-docker-zh-cn is not set
# CONFIG_PACKAGE_luci-i18n-dockerman-zh-cn is not set
# CONFIG_PACKAGE_runc is not set
# CONFIG_PACKAGE_tini is not set
# CONFIG_PACKAGE_luci-app-clash is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn is not set
# tuic-client is a rust program (feeds/helloworld/tuic-client/Makefile:21 is
# PKG_BUILD_DEPENDS:=rust/host), so keeping it forces feeds/packages/lang/rust
# host-compile into every run: measured 22:01Z to past 00:52Z in run 40563945058
# without finishing, one of the two cores gone for three hours. Nothing else in
# this .config needs the rust host toolchain, so it is out. Hysteria, xray,
# trojan, naive and ss/ssr stay - tuic over quic is the only casualty.
# CONFIG_PACKAGE_tuic-client is not set
# CONFIG_PACKAGE_kmod-r8168 is not set
# CONFIG_PACKAGE_r8168-rss is not set
